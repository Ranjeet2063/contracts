{
  "name": "@tx-wat/watcher-registry",
  "version": "0.1.0",
  "description": "TypeScript bindings for the stellar-txwatch WatcherRegistry Soroban contract",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node init && tsc --project tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "smart-contract",
    "watcher-registry",
    "txwatch",
    "blockchain"
  ],
  "author": "Tx-wats <https://github.com/Tx-wats>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tx-wats/contracts.git",
    "directory": "bindings/watcher-registry"
  },
  "homepage": "https://github.com/Tx-wats/contracts#readme",
  "bugs": {
    "url": "https://github.com/Tx-wats/contracts/issues"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
